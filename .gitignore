# Environment variables
.env

# dependencies
node_modules/

# local npm home (cache/config)
.npm-cache/
.npm-home/

# Gatsby/Nest build output
frontend/.cache/
# Ignore everything inside public/ except the hand-written source assets
# the client bundle imports. NOTE: ignore the CONTENTS (public/*), not the
# directory (public/) - git cannot re-include files below an excluded
# directory, so the !-rules would otherwise silently do nothing.
frontend/public/*
!frontend/public/styles.css
!frontend/public/favicon.svg
frontend/dist/

# local Python virtualenv / caches
.venv/
__pycache__/

# headless-browser test scratch (regenerable)
.pw-browsers/
.pw-libs/

# Storybook build output
storybook-static/

# lib build output
libs/**/dist/

# OS
.DS_Store
