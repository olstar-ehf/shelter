{
  "name": "@island.is/windbreak-application",
  "version": "0.0.0",
  "private": true,
  "description": "Windbreak grant application template (Phase 2 of the island.is migration): zod data schema, application states, declarative form with the custom windbreak-lines map field, and the flow renderer.",
  "main": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "fix:link": "node scripts/fix-lib-link.cjs",
    "prebuild": "node scripts/fix-lib-link.cjs",
    "build": "tsc -p tsconfig.lib.json && tsc -p tsconfig.lib.esm.json",
    "pretypecheck": "node scripts/fix-lib-link.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/fix-lib-link.cjs",
    "test": "jest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-intl": "^6.8.0"
  },
  "dependencies": {
    "@island.is/map": "file:../../map",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/jest": "^29.5.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "storybook": "^8.6.18",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.21"
  },
  "module": "dist/esm/index.js"
}
