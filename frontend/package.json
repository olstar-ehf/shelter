{
  "name": "windbreak-grant-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Windbreak grant application form - NestJS server + React Leaflet map client",
  "scripts": {
    "build": "nest build && npm run build:client",
    "build:client": "esbuild client/main.tsx --bundle --minify --sourcemap --jsx=automatic --outfile=public/app.js --loader:.png=file --loader:.svg=file --alias:react=./node_modules/react --alias:react-dom=./node_modules/react-dom --alias:react-intl=./node_modules/react-intl",
    "prestart": "npm run build:client",
    "start": "node dist/main.js",
    "prestart:dev": "npm run build:client",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@island.is/map": "file:../../libs/map",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "hbs": "^4.2.0",
    "intl-messageformat": "^11.2.14",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/hbs": "^4.0.4",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet-draw": "^1.0.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "typescript": "^5.5.0"
  }
}
