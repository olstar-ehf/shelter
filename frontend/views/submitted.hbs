<!DOCTYPE html>
<html lang="{{locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{t.submittedTitle}} – {{t.schemeName}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <div>
          <span class="topbar-brand">{{t.agencyName}}</span>
          <span class="topbar-title">{{t.schemeName}}</span>
        </div>
        <div class="topbar-session">
          <span class="lang-switch" aria-label="Language">
            <a href="?lang=is" class="{{#if isActive}}lang-active{{/if}}">Íslenska</a>
            <span class="lang-sep">|</span>
            <a href="?lang=en" class="{{#if enActive}}lang-active{{/if}}">English</a>
          </span>
        </div>
      </div>
    </header>

    <main class="container">
      <ol class="stepper" aria-label="Application steps">
        {{#each stepperSteps}}
        <li class="{{#if active}}active{{/if}}" data-step="{{no}}">
          <span class="step-no">{{no}}</span> {{label}}
        </li>
        {{/each}}
      </ol>

      {{#if error}}
        <div class="error-banner" role="alert">
          <strong>{{t.errorSomethingWrong}}</strong> {{error}}
        </div>
        <p><a class="btn btn-secondary" href="/apply">{{t.btnBackToApplication}}</a></p>
      {{else}}
      <div class="card card-success">
        <h2>{{t.submittedTitle}}</h2>
        <p>{{t.submittedLead}}</p>

        <h3>{{t.submittedTicketHeading}}</h3>
        <dl class="details">
          {{#if applicationId}}
          <dt>{{t.labelApplicationNo}}</dt>
          <dd><strong>{{applicationId}}</strong></dd>
          {{/if}}
          <dt>{{t.labelTicketNo}}</dt>
          <dd><strong>{{ticketId}}</strong></dd>
          <dt>{{t.labelSubmitted}}</dt>
          <dd>{{submittedAt}}</dd>
        </dl>

        {{#if ticketUrl}}
        <div class="step-actions">
          <a class="btn btn-secondary" href="{{ticketUrl}}" target="_blank" rel="noopener">
            {{t.ticketOpenButton}}
          </a>
        </div>
        {{else}}
        <p class="muted">{{t.submittedNoTicketUrl}}</p>
        {{/if}}

        <p class="muted">{{t.submittedNote}}</p>

        <div class="step-actions">
          <a class="btn btn-primary" href="/apply">
            {{t.btnApplyAgain}}
          </a>
        </div>
      </div>
      {{/if}}
    </main>

    <footer class="app-footer">
      <div class="container">
        <p>{{t.footerPrototype}}</p>
      </div>
    </footer>
  </div>
</body>
</html>
