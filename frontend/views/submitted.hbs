<!DOCTYPE html>
<html lang="{{locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{t.submittedTitle}} – {{t.schemeName}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <div>
          <span class="topbar-brand">{{t.agencyName}}</span>
          <span class="topbar-title">{{t.schemeName}}</span>
        </div>
        <div class="topbar-session">
          <span class="lang-switch" aria-label="Language">
            <a href="?lang=is" class="{{#if isActive}}lang-active{{/if}}">Íslenska</a>
            <span class="lang-sep">|</span>
            <a href="?lang=en" class="{{#if enActive}}lang-active{{/if}}">English</a>
          </span>
        </div>
      </div>
    </header>

    <main class="container">
      <ol class="stepper" aria-label="Application steps">
        <li class="active"><span class="step-no">1</span> {{t.stepYourDetails}}</li>
        <li class="active"><span class="step-no">2</span> {{t.stepDrawWindbreak}}</li>
        <li class="active"><span class="step-no">3</span> {{t.stepReview}}</li>
        <li class="active"><span class="step-no">4</span> {{t.stepSubmitted}}</li>
      </ol>

      {{#if error}}
        <div class="error-banner" role="alert">
          <strong>{{t.errorSomethingWrong}}</strong> {{error}}
        </div>
        <p><a class="btn btn-secondary" href="/apply">{{t.btnBackToApplication}}</a></p>
      {{else}}
      <div class="card card-success">
        <h2>{{t.submittedTitle}}</h2>
        <p>{{t.submittedLead}}</p>

        <dl class="details">
          <dt>{{t.labelApplicationNo}}</dt>
          <dd><strong>{{applicationId}}</strong></dd>
          <dt>{{t.labelSubmitted}}</dt>
          <dd>{{submittedAt}}</dd>
          <dt>{{t.labelWindbreaks}}</dt>
          <dd>{{linesLabel}}</dd>
          <dt>{{t.labelStatus}}</dt>
          <dd><span class="chip chip-ok">{{t.statusPending}}</span></dd>
        </dl>

        <p class="muted">{{t.submittedNote}}</p>

        <h3>{{t.submittedStoredHeading}}</h3>
        <table class="lines-table">
          <thead>
            <tr>
              <th>{{t.colLineId}}</th>
              <th>{{t.colParcel}}</th>
              <th>{{t.colLength}}</th>
              <th>{{t.colStatus}}</th>
            </tr>
          </thead>
          <tbody>
            {{#each lines}}
            <tr>
              <td>{{line_id}}</td>
              <td>{{parcel_id}}</td>
              <td>{{length_m}} m</td>
              <td>{{status}}</td>
            </tr>
            {{/each}}
          </tbody>
        </table>

        <div class="step-actions">
          <a class="btn btn-primary" href="/apply">
            {{t.btnApplyAgain}}
          </a>
        </div>
      </div>
      {{/if}}
    </main>

    <footer class="app-footer">
      <div class="container">
        <p>{{t.footerPrototype}}</p>
      </div>
    </footer>
  </div>
</body>
</html>
