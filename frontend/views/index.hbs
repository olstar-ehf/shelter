<!DOCTYPE html>
<html lang="{{locale}}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{t.schemeName}}</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <div>
          <span class="topbar-brand">{{t.agencyName}}</span>
          <span class="topbar-title">{{t.schemeName}}</span>
        </div>
        <div class="topbar-session">
          <span class="muted-inverse">{{t.portalSession}}</span>
          <span class="lang-switch" aria-label="Language">
            <a href="?lang=is" class="{{#if isActive}}lang-active{{/if}}">Íslenska</a>
            <span class="lang-sep">|</span>
            <a href="?lang=en" class="{{#if enActive}}lang-active{{/if}}">English</a>
          </span>
        </div>
      </div>
    </header>

    <main class="container">
      <ol class="stepper" aria-label="Application steps">
        {{#each stepperSteps}}
        <li class="{{#if active}}active{{/if}}" data-step="{{no}}">
          <span class="step-no">{{no}}</span> {{label}}
        </li>
        {{/each}}
      </ol>

      <div class="card card-center">
        <h1>{{t.indexTitle}}</h1>
        <p>{{t.indexLead}}</p>
        <p class="muted">{{t.indexWhere}}</p>
        <a class="btn btn-primary btn-large" href="/apply">{{t.indexCta}}</a>
        <p class="muted small">{{{indexIdentity}}}</p>
      </div>
    </main>

    <footer class="app-footer">
      <div class="container">
        <p>{{t.footerPrototype}}</p>
      </div>
    </footer>
  </div>
</body>
</html>
