<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Draw your windbreak – Windbreak Grant Application</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/app.css" />
</head>
<body>
  <div class="page">
    <header class="topbar">
      <div class="topbar-inner">
        <div>
          <span class="topbar-brand">Land &amp; Nature Agency</span>
          <span class="topbar-title">Windbreak Grant Scheme</span>
        </div>
        <div class="topbar-session">
          {{#if identity}}
            <span class="session-user">
              {{identity.fullName}} <span class="session-kennitala">(kt. {{identity.kennitala}})</span>
            </span>
            <span class="chip chip-ok">Signed in</span>
          {{else}}
            <span class="muted-inverse">Government portal session</span>
          {{/if}}
        </div>
      </div>
    </header>

    <main class="container">
      <ol class="stepper" id="stepper" aria-label="Application steps">
        <li data-step="1" class="active"><span class="step-no">1</span> Your details</li>
        <li data-step="2" class="active"><span class="step-no">2</span> Draw windbreak</li>
        <li data-step="3"><span class="step-no">3</span> Review</li>
        <li data-step="4"><span class="step-no">4</span> Submitted</li>
      </ol>

      {{#if error}}
        <div class="error-banner" role="alert">
          <strong>Something went wrong:</strong> {{error}}
        </div>
      {{/if}}

      {{#unless error}}
      {{#if lookupSummary}}
      <p class="muted lookup-info">{{lookupSummary}}</p>
      {{/if}}
      <div class="card">
        <h2 id="step-title">Draw your windbreak</h2>
        <div id="draw-help">
          <p class="muted">
            Your registered parcels are shown on the map. Use the
            <strong>line tool</strong> (top right) to draw one or more
            windbreaks inside your land. Click to add points, double-click (or
            press Enter) to finish. Use the edit tools to move or delete lines.
          </p>
          <p class="muted">
            Your land already has
            <strong>{{establishedLabel}}</strong>
            and
            <strong>{{pendingLabel}}</strong>
            (not accepted yet). A new windbreak
            <strong>may not cross or touch</strong> any of them, or another
            windbreak in this application.
          </p>
        </div>
        <div id="review-help" hidden>
          <p class="muted">
            Check the windbreaks you have drawn below and submit the
            application when you are satisfied. In this step the map is
            <strong>read-only</strong>: press <strong>Back to map</strong> to
            add, move or delete a line.
          </p>
        </div>

        <div class="map-container" id="map"></div>

        <div class="map-legend" aria-hidden="true">
          <span><i class="legend-swatch legend-parcel"></i> Your parcels</span>
          <span><i class="legend-swatch legend-established"></i> Established windbreak</span>
          <span><i class="legend-swatch legend-pending"></i> Pending (not accepted)</span>
        </div>

        <div class="lines-summary">
          <h3>Drawn windbreaks (<span id="line-count">0</span>)</h3>
          <p class="muted" id="no-lines">No windbreaks drawn yet.</p>
          <table class="lines-table" id="lines-table" hidden>
            <thead>
              <tr>
                <th>#</th>
                <th>Length</th>
                <th>On parcel</th>
                <th>Check</th>
              </tr>
            </thead>
            <tbody id="lines-body"></tbody>
          </table>

          <div class="review-panel" id="review-panel" hidden>
            <h3>Windbreaks in this application</h3>
            <p class="muted">
              The grant service checks these windbreaks again when you submit.
            </p>
            <table class="lines-table">
              <thead>
                <tr><th>#</th><th>Length</th><th>On parcel</th></tr>
              </thead>
              <tbody id="review-body"></tbody>
            </table>
            <p class="muted">
              Total length:
              <strong><span id="review-total">0</span> m</strong>
            </p>
            <p class="error-text" id="submit-error" hidden></p>
            <div class="step-actions">
              <button type="button" class="btn btn-secondary" id="back-btn">
                Back to map
              </button>
              <button type="button" class="btn btn-primary" id="submit-btn">
                Submit application
              </button>
            </div>
          </div>

          <div class="step-actions">
            <span class="muted">
              Total length:
              <strong><span id="total-length">0</span> m</strong>
            </span>
            <button type="button" class="btn btn-primary" id="review-btn" disabled>
              Review application
            </button>
          </div>
        </div>
      </div>
      {{/unless}}
    </main>

    <footer class="app-footer">
      <div class="container">
        <p>
          Prototype &mdash; farmer authentication is assumed to have happened
          in the portal. Data is served by a pygeoapi OGC API and stored in
          local GeoJSON files.
        </p>
      </div>
    </footer>
  </div>

  {{#unless error}}
  <script id="parcels-data" type="application/json">{{{parcelsJson}}}</script>
  <script id="windbreaks-data" type="application/json">{{{windbreaksJson}}}</script>
  <script src="/app.js"></script>
  {{/unless}}
</body>
</html>
